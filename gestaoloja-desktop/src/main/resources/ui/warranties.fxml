<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1180.0" styleClass="app-root" stylesheets="@styles/app.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pt.ipvc.estg.ui.WarrantyController">
    <left>
        <VBox prefWidth="230.0" spacing="22.0" styleClass="sidebar">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="28.0" />
            </padding>
            <VBox spacing="2.0">
                <Label styleClass="brand-title-small" text="Nordic Curator" />
                <Label styleClass="brand-subtitle" text="GESTAO DE CURADORIA" />
            </VBox>
            <VBox spacing="8.0">
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goDashboard" styleClass="nav-button" text="Dashboard" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goSales" styleClass="nav-button" text="Registar Venda" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goClients" styleClass="nav-button" text="Clientes" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goProducts" styleClass="nav-button" text="Produtos e Stock" />
                <Button maxWidth="Infinity" styleClass="nav-button-active" text="Garantias" />
            </VBox>
            <Region VBox.vgrow="ALWAYS" />
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#logout" styleClass="danger-link-button" text="Terminar Sessao" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <VBox spacing="28.0" styleClass="page">
                <padding>
                    <Insets bottom="34.0" left="42.0" right="42.0" top="24.0" />
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <Label styleClass="top-label" text="Portal de Garantias" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField promptText="Pesquisar ID ou Cliente..." styleClass="search-field" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="18.0">
                    <VBox spacing="8.0">
                        <Label styleClass="breadcrumb" text="GESTAO / GARANTIAS" />
                        <Label styleClass="page-title" text="Gestao de Garantias" />
                        <Label styleClass="muted-text" text="Monitorizacao e acompanhamento de processos de reparacao e devolucao." />
                    </VBox>
                </HBox>

                <GridPane hgap="18.0" vgap="18.0">
                    <VBox GridPane.columnIndex="0" prefWidth="190.0" spacing="10.0" styleClass="metric-card">
                        <Label styleClass="muted-text" text="EM ANALISE" />
                        <Label fx:id="emAnaliseLabel" styleClass="metric-value-small" text="0" />
                    </VBox>
                    <VBox GridPane.columnIndex="1" prefWidth="190.0" spacing="10.0" styleClass="metric-card-warm">
                        <Label styleClass="muted-text" text="APROVADAS" />
                        <Label fx:id="aprovadasLabel" styleClass="metric-value-small" text="0" />
                    </VBox>
                    <VBox GridPane.columnIndex="2" prefWidth="190.0" spacing="10.0" styleClass="metric-card">
                        <Label styleClass="muted-text" text="REJEITADAS" />
                        <Label fx:id="rejeitadasLabel" styleClass="metric-value-small" text="0" />
                    </VBox>
                    <VBox GridPane.columnIndex="3" prefWidth="190.0" spacing="10.0" styleClass="metric-card-dark">
                        <Label styleClass="light-text" text="TOTAL" />
                        <Label fx:id="totalGarantiasLabel" styleClass="metric-value-light" text="0" />
                    </VBox>
                </GridPane>

                <HBox spacing="22.0">
                    <VBox spacing="18.0" styleClass="table-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="section-title" text="Pedidos Recentes" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button mnemonicParsing="false" onAction="#carregarGarantias" styleClass="light-action" text="Atualizar" />
                        </HBox>
                        <TableView fx:id="garantiasTable" prefHeight="360.0" styleClass="data-table">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                                <TableColumn fx:id="colCliente" prefWidth="180.0" text="Cliente" />
                                <TableColumn fx:id="colVenda" prefWidth="100.0" text="Venda" />
                                <TableColumn fx:id="colMotivo" prefWidth="300.0" text="Motivo" />
                                <TableColumn fx:id="colEstado" prefWidth="130.0" text="Estado" />
                            </columns>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <Label styleClass="muted-small" text="Selecione um pedido na tabela para alterar o estado." />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button mnemonicParsing="false" onAction="#aprovarSelecionada" styleClass="success-button" text="Aprovar" />
                            <Button mnemonicParsing="false" onAction="#rejeitarSelecionada" styleClass="danger-button" text="Rejeitar" />
                        </HBox>
                    </VBox>

                    <VBox prefWidth="330.0" spacing="14.0" styleClass="table-card">
                        <Label styleClass="section-title" text="Novo pedido" />
                        <Label styleClass="muted-small" text="Associado a uma venda existente." />
                        <ComboBox fx:id="vendaCombo" prefWidth="290.0" styleClass="form-input" />
                        <TextArea fx:id="motivoArea" prefHeight="140.0" promptText="Motivo do pedido de garantia" styleClass="form-input" wrapText="true" />
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#registarGarantia" styleClass="primary-button" text="Registar Pedido" />
                        <Label fx:id="mensagemLabel" styleClass="message-label" text="" wrapText="true" />
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
